  "delivery_pipeline": {
    "phases": [
      {
        "phase": 1,
        "name": "Discovery",
        "agents": ["pm"],
        "out": "PRD with ISC list"
      },
      {
        "phase": 2,
        "name": "Design (parallel)",
        "agents": ["apidx", "schema", "architect"],
        "out": "API DX memo + Pydantic schemas + architecture decision"
      },
      {
        "phase": 3,
        "name": "Schema",
        "agents": ["database"],
        "out": "SQLAlchemy model diff + Alembic migration plan"
      },
      {
        "phase": 4,
        "name": "Implementation (parallel)",
        "agents": ["agent", "backend"],
        "out": "code changes per Pre-Delegation Contract"
      },
      {
        "phase": 5,
        "name": "Hardening (parallel)",
        "agents": ["security", "qa"],
        "out": "threat model + Test Pyramid Plan"
      },
      {
        "phase": 6,
        "name": "Verification",
        "agents": ["e2e", "qa"],
        "out": "integration tests + ISC verification matrix"
      },
      {
        "phase": 7,
        "name": "Ship",
        "agents": ["devops", "writer"],
        "out": "deploy checklist + docs + ADR"
      },
      {
        "phase": 8,
        "name": "Wrap",
        "agents": ["sm"],
        "out": "delivery summary + retro notes"
      }
    ]
  }
